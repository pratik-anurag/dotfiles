#!/usr/bin/env bash
# Verify the dependencies expected by this dotfiles configuration.
set -uo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
failed=0
check_command() {
	if command -v "$1" >/dev/null 2>&1; then
		printf 'ok   %s\n' "$1"
	else
		printf 'MISS %s\n' "$1"
		failed=1
	fi
}

check_link() {
	if [[ -L "$2" && "$(readlink "$2")" == "$1" ]]; then
		printf 'ok   %s\n' "$2"
	else
		printf 'MISS %s (run bin/install)\n' "$2"
		failed=1
	fi
}

if command -v brew >/dev/null 2>&1; then
	brew bundle check --file="$repo_root/Brewfile" || failed=1
	brew list --cask font-jetbrains-mono-nerd-font >/dev/null 2>&1 || {
		printf 'MISS font-jetbrains-mono-nerd-font\n'
		failed=1
	}
else
	printf 'MISS Homebrew\n'
	failed=1
fi

check_link "$repo_root/nvim" "$HOME/.config/nvim"
for tool in git node python3 go gopls delve actionlint golangci-lint yamllint ruff stylua prettier prettierd eslint_d shellcheck shfmt nvim; do check_command "$tool"; done

if command -v nvim >/dev/null 2>&1; then
	if nvim --headless '+Lazy! sync' +qa; then
		printf 'ok   Lazy sync\n'
	else
		printf 'MISS Lazy sync\n'
		failed=1
	fi
fi
exit "$failed"
